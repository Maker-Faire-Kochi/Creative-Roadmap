      "title-30": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 800, "fontSize": "30px", "lineHeight": "30.3px", "letterSpacing": "-0.6px" }, "$description": "Part names, uppercase" },
      "title-28": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 800, "fontSize": "28px", "lineHeight": "31.36px", "letterSpacing": "0px" }, "$description": "Card titles, sentence case" },
      "body-30": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 400, "fontSize": "30px", "lineHeight": "38.4px", "letterSpacing": "0px" } },
      "body-28": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 400, "fontSize": "28px", "lineHeight": "36px", "letterSpacing": "0px" } },
      "body-26": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 400, "fontSize": "26px", "lineHeight": "33.28px", "letterSpacing": "0px" } },
