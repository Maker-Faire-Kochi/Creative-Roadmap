    "color": {
      "paper": { "$type": "color", "$value": "#f4efdf", "$description": "Default ground. Figma: mf/color/paper" },
      "ink": { "$type": "color", "$value": "#20251f", "$description": "Text, rules, dark ground. Figma: mf/color/ink" },
      "blue": { "$type": "color", "$value": "#2854d9", "$description": "Accent / ground / Malayalam place name. Figma: mf/color/blue" },
      "red": { "$type": "color", "$value": "#ef432d", "$description": "Accent. Figma: mf/color/red" },
      "yellow": { "$type": "color", "$value": "#f7c928", "$description": "Accent. Figma: mf/color/yellow" },
      "white": { "$type": "color", "$value": "#ffffff", "$description": "Logo only. Figma: mf/color/white" },
      "maker-red": { "$type": "color", "$value": "#ed1c24", "$description": "Official Maker Faire logo ONLY. Figma: mf/color/maker-red" },
      "maker-blue": { "$type": "color", "$value": "#00aeef", "$description": "Official Maker Faire logo ONLY. Figma: mf/color/maker-blue" }
    },
    "space": {
