      "body-20": { "$type": "typography", "$value": { "fontFamily": "Bricolage Grotesque", "fontWeight": 400, "fontSize": "20px", "lineHeight": "22.4px", "letterSpacing": "0px" } },
      "label-20": { "$type": "typography", "$value": { "fontFamily": "IBM Plex Mono", "fontWeight": 500, "fontSize": "20px", "lineHeight": "22.4px", "letterSpacing": "0px" }, "$description": "Figma text style 'MF / Campaign type / Label / 20', uppercase" },
