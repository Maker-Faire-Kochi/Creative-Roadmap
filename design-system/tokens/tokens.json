      "malayalam-64": { "$type": "typography", "$value": { "fontFamily": "Noto Sans Malayalam", "fontWeight": 700, "fontSize": "64px", "lineHeight": "71.68px", "letterSpacing": "0px" }, "$description": "കൊച്ചി, blue" }
